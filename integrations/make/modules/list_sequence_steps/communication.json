{
  "url": "/sequences/v1/sequences/{{encodeURL(parameters.pathId)}}/steps",
  "method": "GET",
  "encodeUrl": false,
  "response": {
    "iterate": "{{body.steps}}",
    "output": {
      "result": "{{item}}"
    },
    "limit": "{{parameters.limit}}"
  },
  "pagination": {
    "qs": {
      "cursor": "{{body.next_cursor}}"
    },
    "condition": "{{body.next_cursor}}"
  },
  "qs": {
    "cursor": "{{parameters.queryCursor}}",
    "type": "{{parameters.queryType}}",
    "include_draft": "{{parameters.queryIncludeDraft}}",
    "limit": "{{min(parameters.limit, 100)}}"
  }
}
