{
  "url": "/sequences/v1/enrollments",
  "method": "GET",
  "encodeUrl": false,
  "response": {
    "iterate": "{{body.enrollments}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  },
  "pagination": {
    "qs": {
      "cursor": "{{body.next_cursor}}"
    },
    "condition": "{{body.next_cursor}}"
  },
  "qs": {
    "cursor": "{{parameters.queryCursor}}",
    "sequence_id": "{{parameters.querySequenceId}}",
    "person_id": "{{parameters.queryPersonId}}",
    "mailbox_id": "{{parameters.queryMailboxId}}",
    "enrolled_by_play_id": "{{parameters.queryEnrolledByPlayId}}",
    "status": "{{parameters.queryStatus}}",
    "updated_after": "{{parameters.queryUpdatedAfter}}",
    "updated_before": "{{parameters.queryUpdatedBefore}}",
    "limit": "{{min(parameters.limit, 100)}}"
  }
}
