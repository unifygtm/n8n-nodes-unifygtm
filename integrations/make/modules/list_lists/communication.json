{
  "url": "/data/v1/lists",
  "method": "GET",
  "encodeUrl": false,
  "response": {
    "iterate": "{{body.data}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  },
  "pagination": {
    "qs": {
      "cursor": "{{body.next_cursor}}"
    },
    "condition": "{{body.next_cursor}}"
  },
  "qs": {
    "cursor": "{{parameters.queryCursor}}",
    "object": "{{parameters.queryObject}}",
    "name": "{{parameters.queryName}}",
    "limit": "{{min(parameters.limit, 100)}}"
  }
}
