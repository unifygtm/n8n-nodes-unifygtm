import type { IAuthenticateGeneric, ICredentialType, INodeProperties } from 'n8n-workflow';

export class UnifyAnalyticsApi implements ICredentialType {
 name='unifyAnalyticsApi';
 displayName='Unify Analytics API';
 documentationUrl='https://docs.unifygtm.com/developers/api/analytics/overview';
 icon='file:../nodes/UnifyAnalytics/unify.svg' as const;
 properties:INodeProperties[]=[
  {displayName:'Write Key',name:'writeKey',type:'string',typeOptions:{password:true},default:'',required:true,description:'The write key for your Unify event source'},
  {displayName:'Origin',name:'origin',type:'string',default:'',required:true,placeholder:'https://example.com',description:'An allowed origin configured on your Unify event source'},
 ];
 authenticate:IAuthenticateGeneric={type:'generic',properties:{headers:{'X-Write-Key':'={{$credentials.writeKey}}',Origin:'={{$credentials.origin}}'}}};
 // The published analytics schema has no read-only credential test endpoint.
 // A connection test must not create a synthetic event in a customer workspace.
}
